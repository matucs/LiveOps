# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=liveops
POSTGRES_USER=liveops
POSTGRES_PASSWORD=liveops_dev_password
DATABASE_URL=postgres://liveops:liveops_dev_password@localhost:5434/liveops

# API
PORT=3000
NODE_ENV=development

# Outbox poller
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50

# Consumer / workflow engine
CONSUMER_POLL_INTERVAL_MS=250
CONSUMER_BATCH_SIZE=25
CONSUMER_LEASE_MS=10000
CONSUMER_MAX_ATTEMPTS=5

# Workflow engine
WORKFLOW_ENGINE_BATCH_SIZE=50
