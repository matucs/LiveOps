liveops.130-61-191-125.nip.io {
	encode gzip

	# API and its live stream — matched first, more specific paths win.
	handle /api/* {
		reverse_proxy localhost:3000
	}
	handle /healthz {
		reverse_proxy localhost:3000
	}
	# Exposed publicly on this portfolio deployment deliberately — real
	# Prometheus output someone can actually look at is worth more here
	# than the marginal operational-info risk. A production deployment
	# with something to protect would keep this internal-only.
	handle /metrics {
		reverse_proxy localhost:3000
	}

	# Everything else is the Next.js dashboard.
	handle {
		reverse_proxy localhost:3001
	}
}
