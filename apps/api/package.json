{
  "name": "@liveops/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./src/otel/register.mjs --import tsx/esm src/server.ts",
    "start": "node --import ./dist/otel/register.mjs dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "seed:dev-tenant": "tsx src/scripts/seed-dev-tenant.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
